# Copy to .env if you want to override defaults.
# The app also works with no .env file.

HTTP_ADDR=0.0.0.0:8080
MAX_UPLOAD_MB=32
MAX_STORAGE_GB=5

# Optional. If unset, a random secret is saved in data/.jwt-secret
# JWT_SECRET=paste-a-long-random-string-here

# Email codes for signup and password reset.
# Leave SMTP_HOST empty to print codes in the server log (local demo).
# For a real mailbox (Gmail app password, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=no.reply.cloudfileproject@gmail.com
# SMTP_PASS=gmail-app-password-not-the-normal-password
# SMTP_FROM=SafeKeeping <no.reply.cloudfileproject@gmail.com>
# MAIL_LOG=0
#
# Railway Hobby/Trial blocks SMTP. Use Resend (HTTPS) there instead:
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=SafeKeeping <noreply@safekeeping.lol>
#
# Owner account. Set these in Railway variables, never commit real values.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-long-private-password
